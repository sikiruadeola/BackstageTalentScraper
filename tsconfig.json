{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "outDir": "dist",
        "rootDir": "src",
        "lib": ["DOM", "ESNext"],
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
